{
  "name": "dsh-plugin-pixluna",
  "description": "PixLuna image source tools for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.mjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.js",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix && oxfmt",
    "format": "oxfmt --write .",
    "prepack": "node --run lint && node --run build"
  },
  "license": "MPL-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/PixLunaLab/pixluna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixLunaLab/pixluna"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "pixiv",
    "pixluna"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^25.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "1.0.0-beta.54",
    "rolldown-plugin-dts": "^0.18.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
